import re

rules = [
    (r"hello|hi", "Hello!"),
    (r"how are you", "I am fine"),
    (r"your name", "I am SimpleBot"),
    (r"bye|exit", "Goodbye!")
]

def chatbot(user):
    for pattern, reply in rules:
        if re.search(pattern, user.lower()):
            return reply
    return "Sorry, I don't understand"

while True:
    user = input("You: ")
    print("Bot:", chatbot(user))

    if re.search(r"bye|exit", user.lower()):
        break

